{
  "schemaVersion": 1,
  "id": "uselessreptile",
  "version": "${version}",

  "name": "Useless Reptile",
  "description": "Adds dragons and dragon-like creatures to your world",
  "authors": [
    "Nord_Act"
  ],
  "contact": {
    "homepage": "https://discord.gg/JjYE4vEf3s"
  },
  "license": "All Rights Reserved",
  "icon": "assets/uselessreptile/icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "nordmods.uselessreptile.UselessReptile"
    ],
    "client": [
      "nordmods.uselessreptile.client.UselessReptileClient"
    ],
    "modmenu": [
      "nordmods.uselessreptile.integration.ModMenuIntegration"
    ],
    "preLaunch": [
      "nordmods.uselessreptile.UselessReptile"
    ],
    "fabric-datagen": [
      "nordmods.uselessreptile.datagen.UselessReptileDataGenerator"
    ],
    "jade": [
      "nordmods.uselessreptile.integration.JadeIntegration"
    ]
  },
  "mixins": [
    "uselessreptile.mixins.json"
  ],
  "accessWidener" : "uselessreptile.accesswidener",
  "depends": {
    "fabricloader": ">=0.15",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "biscuit_roll": "*",
    "yet_another_config_lib_v3": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/JjYE4vEf3s"
      }
    },

    "loom:injected_interfaces": {
      "net/minecraft/client/renderer/entity/state/AvatarRenderState": ["nordmods/uselessreptile/client/util/duck/HeadMountDragonRenderState"],
      "net/minecraft/client/renderer/entity/state/LivingEntityRenderState": ["nordmods/uselessreptile/client/util/duck/DragonPassengerRenderState"],
      "net/minecraft/world/entity/player/Player": [
        "nordmods/uselessreptile/common/util/duck/LightningChaserSpawnTimer",
        "nordmods/uselessreptile/common/util/duck/HeadMountDragonOwner"
      ],
      "net/minecraft/server/level/ServerLevel": ["nordmods/uselessreptile/common/util/duck/LightningChaserSpawnTimer"],
      "net/minecraft/server/level/ServerPlayer": ["nordmods/uselessreptile/common/util/duck/DragonInventoryHelper"]
    }
  }
}
